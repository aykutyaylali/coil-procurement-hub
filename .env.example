# ==========================================================================
# Coil Procurement Hub - Ortam Değişkenleri
# Bu dosyayı `.env` olarak kopyalayın ve değerleri doldurun.
# `.env` ASLA versiyon kontrolüne eklenmez.
# ==========================================================================

# --- Uygulama ---
NODE_ENV="development"
APP_NAME="Coil Procurement Hub"
APP_URL="http://localhost:3000"
DEFAULT_TIMEZONE="Europe/Istanbul"
DEFAULT_LOCALE="tr"

# --- Veritabanı ---
# Geliştirme: SQLite (kurulum gerektirmez)
DATABASE_URL="file:./dev.db"
# Migration/introspection için doğrudan bağlantı. Dev'de DATABASE_URL ile AYNI dosya;
# prod'da Neon DIRECT (pooler'sız) string. (schema.prisma → datasource.directUrl)
DIRECT_URL="file:./dev.db"
# Prod DIRECT örneği:
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Üretim: PostgreSQL örneği (yerel)
# DATABASE_URL="postgresql://coil:coil@localhost:5432/coil_procurement?schema=public"
# Üretim (Neon — havuzlanmış/pooled bağlantı, Vercel serverless için ÖNERİLEN):
#   Neon Dashboard > Connection Details > "Pooled connection" URL'sini kullanın.
#   sslmode=require zorunludur; pgbouncer=true havuzlu uçta gereklidir.
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/coil?sslmode=require&pgbouncer=true&connect_timeout=15"
# Supabase alternatifi (Connection Pooling / port 6543):
# DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"

# --- Kimlik doğrulama / oturum ---
# En az 32 karakterlik rastgele bir değer üretin: `openssl rand -base64 48`
AUTH_SECRET="degistirin-en-az-32-karakter-rastgele-gizli-anahtar-01234567"
SESSION_MAX_AGE_SECONDS="28800" # 8 saat
# Magic link (tedarikçi teklif bağlantısı) geçerlilik süresi
MAGIC_LINK_TTL_HOURS="168" # 7 gün

# --- E-posta (Provider seçimi: mock | smtp | graph | sendgrid | ses) ---
EMAIL_PROVIDER="mock"
EMAIL_FROM="satinalma@coilpartners.example"
EMAIL_FROM_NAME="Coil Procurement Hub"
# Gelen yanıtların RFQ ile eşleşmesi için (Reply-To token domaini)
EMAIL_INBOUND_DOMAIN="rfq.coilpartners.example"

# SMTP (EMAIL_PROVIDER=smtp)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# Microsoft 365 / Graph (EMAIL_PROVIDER=graph) — Kurulum: docs/email-graph.md
MS_GRAPH_TENANT_ID=""
MS_GRAPH_CLIENT_ID=""
MS_GRAPH_CLIENT_SECRET=""
MS_GRAPH_SENDER_UPN=""

# SendGrid (EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=""

# Amazon SES (EMAIL_PROVIDER=ses)
AWS_SES_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# --- Dosya depolama (Provider: local | s3) ---
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./storage"
# S3 uyumlu (STORAGE_PROVIDER=s3) — Kurulum: docs/storage-s3.md
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"

# --- Redis / Job Queue (opsiyonel; yoksa in-memory fallback) ---
REDIS_URL=""

# --- Döviz kuru kaynağı (tcmb | manual | mock) ---
EXCHANGE_RATE_PROVIDER="tcmb" # tcmb (ucretsiz, TCMB today.xml) | manual | mock

# --- LME bakır fiyatı otomatik çekme (mock | fastmarkets | lme_api) ---
# mock: dış API gerektirmez, deterministik örnek değer (demo/test). Gerçek sağlayıcı
# için LME_API_URL + LME_API_KEY doldurun (Fastmarkets/LME Official aboneliği gerekir).
LME_PROVIDER="mock"
LME_API_URL=""
LME_API_KEY=""

# --- Virüs tarama (clamav | none) ---
ANTIVIRUS_PROVIDER="none"
CLAMAV_HOST=""
CLAMAV_PORT="3310"

# --- Özellik bayrakları ---
FEATURE_AI="false"
FEATURE_SSO="false"

# --- AI (opsiyonel; FEATURE_AI=true) ---
AI_PROVIDER="none" # none | anthropic
ANTHROPIC_API_KEY=""

# Gelen e-posta webhook imza doğrulaması (HMAC-SHA256, hex; boşsa doğrulama kapalı)
EMAIL_WEBHOOK_SECRET=""

# ==========================================================================
# ÜRETİM (Vercel) — Dashboard > Settings > Environment Variables'a EKLENECEK
# MİNİMUM değişkenler (Production kapsamı):
#   NODE_ENV=production
#   DATABASE_URL=<Neon/Supabase POOLED bağlantı, sslmode=require>
#   AUTH_SECRET=<`openssl rand -base64 48` ile üretin — min 32 karakter>
#   APP_URL=https://<alan-adiniz>            # örn. https://satinalma.coilpartners.com
#   EMAIL_PROVIDER=smtp|graph|sendgrid|ses   # canlıda "mock" KULLANMAYIN
#   (seçtiğiniz provider'ın SMTP_*/MS_GRAPH_*/SENDGRID_*/AWS_* değerleri)
# ÖNERİLEN: STORAGE_PROVIDER=s3 (Vercel dosya sistemi kalıcı DEĞİLDİR; local depolama
#   deploy'lar arasında kaybolur). S3_* değerlerini doldurun (bkz. docs/storage-s3.md).
# Not: Bu proje NextAuth kullanmaz; secret adı AUTH_SECRET (NEXTAUTH_SECRET DEĞİL),
#      URL adı APP_URL'dir (NEXT_PUBLIC_APP_URL değil).
# ==========================================================================
